<%@ Master Language="C#" AutoEventWireup="true" CodeFile="Site.Master.cs" Inherits="BloomSpace.SiteMaster" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FFF9F2" />
    <title><%: Page.Title %></title>
    <meta name="description" content="Bloom Space — thoughtfully arranged luxury flowers for life's most meaningful moments. Every Bloom Tells a Story." />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="<%= ResolveUrl("~/CSS/Style.css") %>" />
    <link rel="icon" type="image/svg+xml" href="<%= ResolveUrl("~/Images/Logo/favicon.svg") %>" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
<form id="form1" runat="server">

    <a class="skip-link" href="#main-content">Skip to content</a>

    <div class="announcement">
        <span>Complimentary delivery on orders above &#8377;2,000</span>
        <span class="announcement-dot" aria-hidden="true"></span>
        <span>Hand-tied in Chennai, delivered with care</span>
    </div>

    <header class="site-header" id="siteHeader">
        <div class="container navbar">

            <a class="brand" href="<%= ResolveUrl("~/Pages/Home.aspx") %>" aria-label="Bloom Space home">
                <img class="brand-mark" src="<%= ResolveUrl("~/Images/Logo/bloom-mark.svg") %>" alt="" width="38" height="38" />
                <span class="brand-text">
                    BLOOM<span>SPACE</span>
                    <small>Every bloom tells a story</small>
                </span>
            </a>

            <nav class="nav-links" id="navLinks" aria-label="Primary navigation">
                <a class="<%= HomeClass %>" href="<%= ResolveUrl("~/Pages/Home.aspx") %>">Home</a>
                <a class="<%= ShopClass %>" href="<%= ResolveUrl("~/Pages/Shop.aspx") %>">Shop Flowers</a>
                <a class="<%= CustomClass %>" href="<%= ResolveUrl("~/Pages/CustomBouquet.aspx") %>">Custom Bouquet</a>
                <a class="<%= AboutClass %>" href="<%= ResolveUrl("~/Pages/About.aspx") %>">Our Story</a>
                <a class="<%= ContactClass %>" href="<%= ResolveUrl("~/Pages/Contact.aspx") %>">Contact</a>

                <div class="mobile-account">
                    <asp:Panel ID="pnlMobileLoggedIn" runat="server" Visible="false">
                        <span class="mobile-account-name">Signed in as <asp:Literal ID="litMobileFirstName" runat="server" /></span>
                        <asp:LinkButton ID="lnkLogoutMobile" runat="server" CssClass="mobile-account-link" CausesValidation="false" OnClick="lnkLogout_Click">Sign out</asp:LinkButton>
                    </asp:Panel>
                    <asp:Panel ID="pnlMobileGuest" runat="server" Visible="false">
                        <a href="<%= ResolveUrl("~/Account/Login.aspx") %>">Sign in</a>
                        <a href="<%= ResolveUrl("~/Account/Register.aspx") %>">Create account</a>
                    </asp:Panel>
                </div>
            </nav>

            <div class="nav-actions">

                <asp:Panel ID="pnlLoggedIn" runat="server" CssClass="account-nav" Visible="false">
                    <span class="account-greeting">Hello, <asp:Literal ID="litFirstName" runat="server" /></span>
                    <asp:LinkButton ID="lnkLogout" runat="server" CssClass="account-link" CausesValidation="false" OnClick="lnkLogout_Click">Sign out</asp:LinkButton>
                </asp:Panel>

                <asp:Panel ID="pnlGuest" runat="server" CssClass="account-nav" Visible="false">
                    <a class="account-link" href="<%= ResolveUrl("~/Account/Login.aspx") %>">Sign in</a>
                    <a class="account-cta" href="<%= ResolveUrl("~/Account/Register.aspx") %>">Create account</a>
                </asp:Panel>

                <a class="bag-link" href="<%= ResolveUrl("~/Pages/Cart.aspx") %>" aria-label="Shopping bag">
                    <svg class="bag-icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 8h12l-1 12H7L6 8Z" />
                        <path d="M9 8V6a3 3 0 0 1 6 0v2" />
                    </svg>
                    <span class="bag-label">Bag</span>
                    <span class="bag-count"><asp:Literal ID="litCartCount" runat="server" Text="0" /></span>
                </a>

                <button type="button" class="menu-toggle" id="menuToggle" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks">
                    <span></span>
                    <span></span>
                </button>
            </div>

        </div>
    </header>

    <main id="main-content">
        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </main>

    <footer class="site-footer">
        <div class="container footer-main">

            <div class="footer-brand">
                <a class="brand brand-footer" href="<%= ResolveUrl("~/Pages/Home.aspx") %>">
                    <img class="brand-mark" src="<%= ResolveUrl("~/Images/Logo/bloom-mark.svg") %>" alt="" width="40" height="40" />
                    <span class="brand-text">
                        BLOOM<span>SPACE</span>
                        <small>Every bloom tells a story</small>
                    </span>
                </a>
                <p>Thoughtfully arranged flowers for life's beautiful moments. Hand-tied with care in Chennai, delivered across India.</p>
            </div>

            <div class="footer-column">
                <h4>Explore</h4>
                <a href="<%= ResolveUrl("~/Pages/Shop.aspx") %>">Shop Flowers</a>
                <a href="<%= ResolveUrl("~/Pages/CustomBouquet.aspx") %>">Custom Bouquet</a>
                <a href="<%= ResolveUrl("~/Pages/About.aspx") %>">Our Story</a>
                <a href="<%= ResolveUrl("~/Pages/Contact.aspx") %>">Contact Us</a>
            </div>

            <div class="footer-column">
                <h4>Information</h4>
                <a href="<%= ResolveUrl("~/Pages/FAQ.aspx") %>">FAQs</a>
                <a href="<%= ResolveUrl("~/Pages/DeliveryPolicy.aspx") %>">Delivery Policy</a>
                <a href="<%= ResolveUrl("~/Pages/Cart.aspx") %>">Your Bag</a>
                <a href="<%= ResolveUrl("~/Account/Login.aspx") %>">Sign In</a>
            </div>

            <div class="footer-column">
                <h4>Get In Touch</h4>
                <a href="mailto:hello@bloomspace.in">hello@bloomspace.in</a>
                <a href="tel:+914412345678">+91 44 1234 5678</a>
                <span>Anna Nagar, Chennai,<br />Tamil Nadu 600040</span>
                <span class="footer-social">Instagram &middot; Pinterest</span>
            </div>

        </div>

        <div class="container footer-bottom">
            <span>&copy; <asp:Literal ID="litYear" runat="server" /> Bloom Space. All rights reserved.</span>
            <span>Made with care, in every petal.</span>
        </div>
    </footer>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script src="<%= ResolveUrl("~/JavaScript/script.js") %>"></script>
    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />

</form>
</body>
</html>
