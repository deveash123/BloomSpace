<?xml version="1.0" encoding="utf-8"?>
<!--
  BLOOM SPACE - application configuration
  ============================================================
  The project is an ASP.NET Web Forms "Web Site" (App_Code model),
  so it opens with:  File > Open > Web Site...  in Visual Studio 2022.

  DATABASE
  ========
  The default connection string uses SQL Server LocalDB, which is
  installed with the Visual Studio ASP.NET workload. If your machine
  uses SQL Server Express instead, comment out the first connection
  string and uncomment the second one.

  Run Database\BloomSpaceDB.sql once before starting the site.
  ============================================================
-->
<configuration>

  <connectionStrings>
    <add name="BloomSpaceDB"
         connectionString="Data Source=(LocalDB)\MSSQLLocalDB;Initial Catalog=BloomSpaceDB;Integrated Security=True;MultipleActiveResultSets=True;Application Name=BloomSpace"
         providerName="System.Data.SqlClient" />

    <!-- SQL Server Express alternative:
    <add name="BloomSpaceDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=BloomSpaceDB;Integrated Security=True;MultipleActiveResultSets=True;Application Name=BloomSpace"
         providerName="System.Data.SqlClient" />
    -->
  </connectionStrings>

  <appSettings>
    <add key="SiteName" value="Bloom Space" />
  </appSettings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" requestValidationMode="4.5" />

    <!-- Customers never see stack traces. Details are still visible on the
         local machine (RemoteOnly) and are written to App_Data\Logs. -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Pages/Home.aspx?error=1" />

    <sessionState mode="InProc" timeout="60" cookieless="UseCookies" />
    <httpCookies httpOnlyCookies="true" />

    <globalization fileEncoding="utf-8" requestEncoding="utf-8"
                   responseEncoding="utf-8" culture="en-IN" uiCulture="en-IN" />

    <pages controlRenderingCompatibilityVersion="4.0"
           clientIDMode="AutoID"
           maintainScrollPositionOnPostBack="true" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Pages/Home.aspx" />
      </files>
    </defaultDocument>

    <directoryBrowse enabled="false" />
    <httpErrors errorMode="DetailedLocalOnly" />

    <staticContent>
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
    </staticContent>
  </system.webServer>

</configuration>
