<?xml version="1.0"?>
<!--
  BLOOM SPACE - Web.config
  ASP.NET Web Forms, .NET Framework 4.8 (Web Site project).

  DATABASE: run Database/BloomSpaceDB.sql once, then check the connection string below.
    - Visual Studio LocalDB (default below):  (localdb)\MSSQLLocalDB
    - SQL Server Express:                      .\SQLEXPRESS
-->
<configuration>

  <appSettings>
    <!-- Lets us use normal ASP.NET controls without the jQuery validation scripts. -->
    <add key="ValidationSettings:UnobtrusiveValidationMode" value="None" />
    <!-- Flat delivery fee in INR, used by the bouquet builder, cart and checkout. -->
    <add key="DeliveryFee" value="99" />
  </appSettings>

  <connectionStrings>
    <add name="BloomSpaceDB"
         connectionString="Data Source=db82285.databaseasp.net,1433;Initial Catalog=db82285;User ID=db82285;Password=zY?73_aB-oZ8;Encrypt=True;TrustServerCertificate=True;MultipleActiveResultSets=True;Application Name=BloomSpace"
         providerName="System.Data.SqlClient" />
  </connectionStrings>

  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="2048" />

    <pages controlRenderingCompatibilityVersion="4.0">
      <namespaces>
        <!-- Makes BloomSpace.Money, BloomSpace.AuthHelper etc. usable inside .aspx files. -->
        <add namespace="BloomSpace" />
      </namespaces>
    </pages>

    <globalization requestEncoding="utf-8" responseEncoding="utf-8" fileEncoding="utf-8" />
    <authentication mode="None" />
    <sessionState mode="InProc" timeout="30" cookieless="false" />
    <httpCookies httpOnlyCookies="true" />

    <!-- Visitors never see stack traces or SQL errors. RemoteOnly still shows details on your own PC while developing. -->
    <customErrors mode="RemoteOnly" defaultRedirect="~/Pages/Home.aspx" />
  </system.web>

  <system.webServer>
    <defaultDocument>
      <files>
        <clear />
        <add value="Pages/Home.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
